{
  "name": "@templjs/context-graph",
  "version": "0.1.0",
  "description": "Dependency-agnostic context graph contracts and engine for context publication/querying",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "lint": "echo 'No linting configured yet'",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); rmSync('tsconfig.tsbuildinfo', { force: true });\""
  },
  "keywords": [
    "context-graph",
    "context",
    "graph",
    "lsp"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
