{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "stripInternal": true,
    "paths": {
      "@templjs/core": ["src/packages/core/src/index.ts"],
      "@templjs/context-graph": ["src/packages/context-graph/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../context-graph"
    }
  ]
}
