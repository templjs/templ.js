{
  "name": "@templjs/volar",
  "version": "0.1.0",
  "description": "Volar language server plugin for templjs templates",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "lint": "echo 'No linting configured yet'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "volar",
    "language-server",
    "vscode",
    "templjs",
    "lsp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/templjs/templ.js.git",
    "directory": "src/packages/volar"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@templjs/core": "workspace:*",
    "@templjs/context-graph": "workspace:*",
    "@volar/language-core": "~2.0.0",
    "gray-matter": "^4.0.3"
  }
}
