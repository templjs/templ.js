{
  "name": "@templjs/language-core",
  "version": "0.1.0",
  "description": "TemplJS language-core contracts and Volar language plugin foundations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "pretest": "pnpm build",
    "build": "tsc",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); rmSync('tsconfig.tsbuildinfo', { force: true });\""
  },
  "keywords": [
    "templjs",
    "language-core",
    "volar",
    "contracts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/templjs/templ.js.git",
    "directory": "src/packages/language-core"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@templjs/volar": "workspace:*",
    "@volar/language-core": "~2.4.0",
    "vscode-uri": "^3.0.8"
  }
}
