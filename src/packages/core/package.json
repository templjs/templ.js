{
  "name": "@templjs/core",
  "version": "0.1.0",
  "description": "Core template parser, renderer, and query engine for templjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "lint": "echo 'No linting configured yet'",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); rmSync('tsconfig.tsbuildinfo', { force: true });\""
  },
  "keywords": [
    "template",
    "parser",
    "ast",
    "rendering",
    "templjs",
    "code-generation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/templjs.git",
    "directory": "src/packages/core"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^2.1.1",
    "chevrotain": "^11.0.3"
  }
}
