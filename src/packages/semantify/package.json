{
  "name": "@templjs/semantify",
  "version": "0.1.0",
  "description": "TemplJS semantify services for semantic context, references, and candidate planning",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); rmSync('tsconfig.tsbuildinfo', { force: true });\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/templjs/templ.js.git",
    "directory": "src/packages/semantify"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@templjs/context-graph": "workspace:*",
    "@templjs/core": "workspace:*",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/semver": "^7.5.8"
  }
}
