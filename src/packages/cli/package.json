{
  "name": "@templjs/cli",
  "version": "1.0.0-beta.1",
  "description": "Command-line interface for templjs template processing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "templjs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "test:memory": "TEMPLJS_ENABLE_MEMORY_ASSERTS=1 NODE_OPTIONS=--expose-gc vitest run --config vitest.config.ts test/signal-handling.test.ts",
    "lint": "echo 'No linting configured yet'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "cli",
    "template",
    "code-generation",
    "templjs",
    "command-line"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/templjs.git",
    "directory": "src/packages/cli"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@templjs/core": "workspace:*",
    "commander": "^14.0.3",
    "jsonparse": "^1.3.1",
    "js-yaml": "^4.1.0",
    "@iarna/toml": "^2.2.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/xml2js": "^0.4.11"
  }
}
