{
  "name": "@templjs/cli",
  "version": "0.1.0",
  "description": "Command-line interface for templjs template processing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "templjs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "lint": "echo 'No linting configured yet'",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "template",
    "code-generation",
    "templjs",
    "command-line"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/templjs.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@templjs/core": "workspace:*",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.0",
    "@iarna/toml": "^2.2.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.2",
    "vitest": "^4.0.18",
    "typescript": "^5.3.0",
    "@types/node": "^20.11.0",
    "@types/js-yaml": "^4.0.5",
    "@types/xml2js": "^0.4.11"
  }
}
