{
  "comments": {
    "lineComment": "//",
    "blockComment": ["{#", "#}"]
  },
  "wordPattern": "\"[^\"\\n]*\"|'[^'\\n]*'|[^\\s\\[\\]\\{\\}(),:]+",
  "brackets": [
    ["{%", "%}"],
    ["{{", "}}"],
    ["{#", "#}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{%", "close": "%}" },
    { "open": "{{", "close": "}}" },
    { "open": "{#", "close": "#}" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["{%", "%}"],
    ["{{", "}}"],
    ["{#", "#}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ]
}
