{
  "name": "vscode-templjs",
  "private": true,
  "displayName": "TemplJS Language Support",
  "description": "Language support for templjs meta-templates",
  "version": "0.1.0",
  "publisher": "templjs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vscode-extension",
    "template",
    "templjs",
    "language-server"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/templjs.png",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "templjs.test",
        "title": "TemplJS: Test Extension"
      }
    ],
    "languages": [
      {
        "id": "templjs-yaml",
        "aliases": [
          "TemplJS YAML",
          "templjs-yaml"
        ],
        "extensions": [
          ".yaml.templ",
          ".yaml.tmpl",
          ".yml.templ",
          ".yml.tmpl",
          ".yaml.tpl",
          ".yml.tpl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "templjs-json",
        "aliases": [
          "TemplJS JSON",
          "templjs-json"
        ],
        "extensions": [
          ".json.templ",
          ".json.tmpl",
          ".json.tpl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "templjs-markdown",
        "aliases": [
          "TemplJS Markdown",
          "templjs-md"
        ],
        "extensions": [
          ".md.templ",
          ".md.tmpl",
          ".md.tpl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "templjs-html",
        "aliases": [
          "TemplJS HTML",
          "templjs-html"
        ],
        "extensions": [
          ".html.templ",
          ".html.tmpl",
          ".html.tpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.templjs",
        "path": "./syntaxes/templjs.tmLanguage.json"
      },
      {
        "language": "templjs-markdown",
        "scopeName": "text.templjs.markdown",
        "path": "./syntaxes/injection-markdown.json",
        "embeddedLanguages": {
          "meta.embedded.block.markdown": "markdown"
        }
      },
      {
        "language": "templjs-html",
        "scopeName": "text.templjs.html",
        "path": "./syntaxes/injection-html.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html"
        }
      },
      {
        "language": "templjs-json",
        "scopeName": "text.templjs.json",
        "path": "./syntaxes/injection-json.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json"
        }
      },
      {
        "language": "templjs-yaml",
        "scopeName": "text.templjs.yaml",
        "path": "./syntaxes/injection-yaml.json",
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TemplJS",
      "properties": {
        "templjs.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "templjs.serverModuleFormat": {
          "scope": "window",
          "type": "string",
          "enum": [
            "cjs",
            "esm"
          ],
          "default": "cjs",
          "description": "Selects the server bundle module format to launch. Keep as cjs for release safety; use esm for WI-107 prototype validation."
        },
        "templjs.schemaPath": {
          "scope": "resource",
          "type": "string",
          "default": "",
          "description": "Path to a JSON Schema file used for templjs variable completions and diagnostics. Relative paths resolve from the workspace root. Can be a filesystem path or HTTPS URL. (Deprecated: prefer templjs.schemas with glob patterns)"
        },
        "templjs.contentSchemaPath": {
          "scope": "resource",
          "type": "string",
          "default": "",
          "description": "Path to a JSON Schema file used for markdown content validation. Relative paths resolve from the workspace root. Can be a filesystem path or HTTPS URL."
        },
        "templjs.schemas": {
          "scope": "resource",
          "type": "object",
          "default": {},
          "description": "Glob-pattern-based schema configuration. Keys are glob patterns (e.g. 'backlog/**', 'docs/**'); values are objects with schemaPath and contentSchemaPath.",
          "markdownDescription": "Glob-pattern-based schema configuration. Keys are glob patterns (e.g. 'backlog/**', 'docs/**'); values are objects with schemaPath and contentSchemaPath. Example: `{ \"backlog/**\": { \"schemaPath\": \"https://schemas.example.com/work-item-frontmatter.json\", \"contentSchemaPath\": \"https://schemas.example.com/work-item-content.json\" } }`.",
          "patternProperties": {
            ".*": {
              "type": "object",
              "properties": {
                "schemaPath": {
                  "type": "string",
                  "description": "Path or HTTPS URL to the templ schema (frontmatter) for files matching this glob pattern."
                },
                "contentSchemaPath": {
                  "type": "string",
                  "description": "Path or HTTPS URL to the content schema (markdown body) for files matching this glob pattern."
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "configurationDefaults": {
      "[templjs-yaml]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": true
        },
        "editor.suggestOnTriggerCharacters": true
      },
      "[templjs-json]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": true
        },
        "editor.suggestOnTriggerCharacters": true
      },
      "[templjs-markdown]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": true
        },
        "editor.suggestOnTriggerCharacters": true
      },
      "[templjs-html]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": true
        },
        "editor.suggestOnTriggerCharacters": true
      }
    }
  },
  "scripts": {
    "build": "tsc -b --force && node ./scripts/build.mjs && node ./scripts/validate-bundled-deps.mjs",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true}); for (const entry of fs.readdirSync('.')) if (/^(?:templjs|vscode-templjs)-.*\\.vsix$/.test(entry)) fs.rmSync(entry,{force:true});\"",
    "lint": "node -e \"console.log('No linting configured yet')\" --",
    "package": "node -e \"require('node:fs').mkdirSync('../../../out',{recursive:true})\" && vsce package --no-dependencies --out ../../../out/templjs-verify.vsix",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:host": "pnpm run build && node ./test/extension-host/runTests.js",
    "test:host:features": "pnpm run build && node ./test/extension-host/runFeatureTests.js",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "test:smoke": "pnpm run build && playwright test -c playwright.smoke.config.ts",
    "vscode:prepublish": "pnpm run build",
    "watch": "tsc -watch -p ./",
    "test:integration": "pnpm run test -- test/volar-labs.probes.test.ts test/service-plugins.test.ts test/grammar-smoke.test.ts && pnpm run test:host:features"
  },
  "dependencies": {
    "@templjs/core": "workspace:*",
    "@templjs/language-server": "workspace:*",
    "@templjs/language-service": "workspace:*",
    "@templjs/volar": "workspace:*",
    "@volar/language-server": "~2.4.0",
    "@volar/language-service": "~2.4.0",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^9.0.9",
    "tslib": "^2.8.1",
    "vscode-json-languageservice": "^5.6.3",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "0.28.1",
    "mocha": "^11.7.5",
    "playwright": "^1.59.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/templjs/templ.js.git",
    "directory": "src/extensions/vscode"
  },
  "license": "Apache-2.0"
}
