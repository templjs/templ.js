{
  "name": "vscode-templjs",
  "private": true,
  "displayName": "Templjs",
  "description": "Language support for templjs meta-templates",
  "version": "0.1.0",
  "publisher": "templjs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vscode-extension",
    "template",
    "templjs",
    "language-server"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "templjs.test",
        "title": "Templjs: Test Extension"
      }
    ],
    "languages": [
      {
        "id": "templjs-yaml",
        "aliases": [
          "Templjs YAML",
          "templjs-yaml"
        ],
        "extensions": [
          ".yaml.templ",
          ".yaml.tmpl",
          ".yml.templ",
          ".yml.tmpl",
          ".yaml.tpl",
          ".yml.tpl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "templjs-json",
        "aliases": [
          "Templjs JSON",
          "templjs-json"
        ],
        "extensions": [
          ".json.templ",
          ".json.tmpl",
          ".json.tpl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "templjs-markdown",
        "aliases": [
          "Templjs Markdown",
          "templjs-md"
        ],
        "extensions": [
          ".md.templ",
          ".md.tmpl",
          ".md.tpl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "templjs-html",
        "aliases": [
          "Templjs HTML",
          "templjs-html"
        ],
        "extensions": [
          ".html.templ",
          ".html.tmpl",
          ".html.tpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.templjs",
        "path": "./syntaxes/templjs.tmLanguage.json"
      },
      {
        "language": "templjs-markdown",
        "scopeName": "text.templjs.markdown",
        "path": "./syntaxes/injection-markdown.json",
        "embeddedLanguages": {
          "meta.embedded.block.markdown": "markdown"
        }
      },
      {
        "language": "templjs-html",
        "scopeName": "text.templjs.html",
        "path": "./syntaxes/injection-html.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html"
        }
      },
      {
        "language": "templjs-json",
        "scopeName": "text.templjs.json",
        "path": "./syntaxes/injection-json.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json"
        }
      },
      {
        "language": "templjs-yaml",
        "scopeName": "text.templjs.yaml",
        "path": "./syntaxes/injection-yaml.json",
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Templjs",
      "properties": {
        "templjs.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "templjs.schemaPath": {
          "scope": "resource",
          "type": "string",
          "default": "",
          "description": "Path to a JSON Schema file used for templjs variable completions and diagnostics. Relative paths resolve from the workspace root. Can be a filesystem path or HTTPS URL. (Deprecated: prefer templjs.schemas with glob patterns)"
        },
        "templjs.contentSchemaPath": {
          "scope": "resource",
          "type": "string",
          "default": "",
          "description": "Path to a JSON Schema file used for markdown content validation. Relative paths resolve from the workspace root. Can be a filesystem path or HTTPS URL."
        },
        "templjs.schemas": {
          "scope": "resource",
          "type": "object",
          "default": {},
          "description": "Glob-pattern-based schema configuration. Keys are glob patterns (e.g. 'backlog/**', 'docs/**'); values are objects with schemaPath and contentSchemaPath.",
          "markdownDescription": "Glob-pattern-based schema configuration. Keys are glob patterns (e.g. 'backlog/**', 'docs/**'); values are objects with schemaPath and contentSchemaPath. Example: `{ \"backlog/**\": { \"schemaPath\": \"https://schemas.example.com/work-item-frontmatter.json\", \"contentSchemaPath\": \"https://schemas.example.com/work-item-content.json\" } }`.",
          "patternProperties": {
            ".*": {
              "type": "object",
              "properties": {
                "schemaPath": {
                  "type": "string",
                  "description": "Path or HTTPS URL to the templ schema (frontmatter) for files matching this glob pattern."
                },
                "contentSchemaPath": {
                  "type": "string",
                  "description": "Path or HTTPS URL to the content schema (markdown body) for files matching this glob pattern."
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "pnpm exec tsx ../../../scripts/ci/run-vitest-watchdog.ts --config vitest.config.ts --coverage",
    "lint": "echo \"No linting configured yet\" && exit 0",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@templjs/core": "workspace:*",
    "@templjs/volar": "workspace:*",
    "@volar/language-server": "~2.0.0",
    "gray-matter": "^4.0.3",
    "minimatch": "^9.0.7",
    "tslib": "^2.6.0",
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.7.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/templjs.git",
    "directory": "src/extensions/vscode"
  },
  "license": "Apache-2.0"
}
