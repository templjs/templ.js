{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TemplJS YAML",
  "scopeName": "text.templjs.yaml",
  "repository": {
    "embeddedYaml": {
      "begin": "\\A",
      "end": "\\z",
      "name": "meta.embedded.block.yaml",
      "patterns": [
        {
          "include": "#yamlTemplScalar"
        },
        {
          "include": "source.templjs"
        },
        {
          "include": "source.yaml"
        },
        {
          "include": "#yamlScalarValue"
        }
      ]
    },
    "yamlTemplScalar": {
      "begin": "^(\\s*[^:#\\n][^:\\n]*:\\s*)(?=.*(?:\\{\\{|\\{%|\\{#))",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "meta.mapping.key.yaml"
        }
      },
      "patterns": [
        {
          "include": "source.templjs"
        },
        {
          "include": "source.yaml"
        }
      ]
    },
    "yamlScalarValue": {
      "match": "^(\\s*[^:#\\n][^:\\n]*:\\s*)(?!\\[)(?!\\{)(?!(?:~|null|Null|NULL|true|True|TRUE|false|False|FALSE)\\s*(?:#.*)?$)(?![+-]?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\s*(?:#.*)?$)([^#\\n]+)",
      "captures": {
        "1": {
          "name": "meta.mapping.key.yaml"
        },
        "2": {
          "name": "string.unquoted.yaml"
        }
      }
    }
  },
  "patterns": [
    {
      "include": "#embeddedYaml"
    },
    {
      "include": "source.yaml"
    },
    {
      "include": "source.templjs"
    }
  ]
}
