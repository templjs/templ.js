{# JSON API example showing object projection and array iteration. #}
{
  "request_id": "{{ request.id }}",
  "timestamp": "{{ request.timestamp }}",
  "customer": {
    "id": "{{ customer.id }}",
    "tier": "{{ customer.tier }}"
  },
  "features": [{%- for feature in features -%}"{{- feature -}}"{%- if !loop.last -%},{%- endif -%}{%- endfor -%}]
}
