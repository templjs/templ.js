<!doctype html>
<html
  lang="en"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="utf-8" />
    <title>Notification</title>
    <style>
      body,
      table,
      td,
      p,
      a,
      strong {
        font-family: Arial, Helvetica, sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        body,
        .bg {
          background-color: #0f172a !important;
          color: #e5e7eb !important;
        }

        table,
        td,
        p,
        strong,
        .text {
          color: #e5e7eb !important;
        }

        .card {
          background-color: #111827 !important;
          border-color: #334155 !important;
        }

        .line {
          border-color: #334155 !important;
        }

        .muted {
          color: #94a3b8 !important;
        }

        a,
        .link {
          color: #93c5fd !important;
        }
      }
    </style>
  </head>
  <body class="bg">
    <div
      style="display: none; font-size: 1px; line-height: 1px; max-height: 0; max-width: 0; opacity: 0; overflow: hidden; mso-hide: all;"
    >
      Your order update is ready - see status, items, and total at a glance.
    </div>
    <div
      style="display: none; font-size: 1px; line-height: 1px; max-height: 0; max-width: 0; opacity: 0; overflow: hidden; mso-hide: all;"
    >
      &zwnj;&nbsp;&zwnj;&nbsp;
    </div>
    <table
      class="bg"
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="border-collapse: collapse; background-color: #f5f7fa; margin: 0; padding: 0;"
    >
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table
            class="card"
            role="presentation"
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="border-collapse: collapse; width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #e5e7eb;"
          >
            <tr>
              <td class="text" style="padding: 24px; color: #111827; line-height: 1.5; font-size: 16px;">
                <p style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700;">
                  Hello <strong>{{ user.first_name | escape }}</strong>,
                </p>

                <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6;">
                  Your order <strong>{{ order.id | escape }}</strong> is now
                  <strong>{{ order.status | escape }}</strong>.
                </p>

                {% if order.items %}
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="border-collapse: collapse; margin: 0 0 16px;"
                >
                  {% for item in order.items %}
                  <tr>
                    <td
                      class="text line"
                      style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-size: 15px; line-height: 1.5; color: #374151;"
                    >
                      <p style="margin: 0;">
                        <strong style="font-weight: 700;">{{ item.name }}</strong>
                        <span class="muted" style="color: #6b7280;">x{{ item.quantity }}</span>
                      </p>
                    </td>
                  </tr>
                  {% endfor %}
                </table>
                {% endif %}

                <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #111827;">
                  Total: <strong style="font-weight: 700;">{{ order.currency | default(order.currency_code) | default('USD') | escape }} {{ order.total | escape }}</strong>
                </p>

                <!-- If you add images later, include explicit width and descriptive alt text for email client compatibility. -->
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
