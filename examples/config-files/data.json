{
  "app": {
    "name": "templjs-app",
    "image": "ghcr.io/templjs/app:latest",
    "env_entries": [
      { "name": "NODE_ENV", "value": "production" },
      { "name": "PORT", "value": 3000 },
      { "name": "LOG_LEVEL", "value": "info" }
    ]
  },
  "services": [
    {
      "name": "web",
      "image": "ghcr.io/templjs/app:latest",
      "port": 3000,
      "depends_on": ["redis"]
    },
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "port": 6379
    }
  ]
}
