{# Docker Compose example showing one source of truth for multiple services. #}
services:
{% for service in services %}
  {{ service.name }}:
    image: {{ service.image }}
    ports:
      - "{{ service.port }}:{{ service.port }}"
{% if service.depends_on is defined and service.depends_on %}
    depends_on:
{% for dependency in service.depends_on %}
      - {{ dependency }}
{% endfor %}
{% endif -%}
{% endfor -%}
