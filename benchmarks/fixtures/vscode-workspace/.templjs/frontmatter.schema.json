{
  "$defs": {
    "workItemDefaults": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "milestone": { "type": "string" },
        "owner": { "$ref": "./common.schema.json#/$defs/person" },
        "reviewers": {
          "type": "array",
          "items": { "$ref": "./common.schema.json#/$defs/person" }
        }
      },
      "required": ["title", "milestone", "owner"],
      "additionalProperties": true
    }
  }
}
