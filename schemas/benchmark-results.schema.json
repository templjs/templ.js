{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://templjs.dev/schemas/benchmark-results.schema.json",
  "title": "templjs benchmark results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "suite",
    "mode",
    "label",
    "git",
    "environment",
    "settings",
    "cases",
    "totals"
  ],
  "properties": {
    "schemaVersion": { "const": "benchmark-results.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "suite": { "const": "templjs" },
    "mode": { "enum": ["full", "ci"] },
    "label": { "type": "string" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha"],
      "properties": {
        "branch": { "type": ["string", "null"] },
        "sha": { "type": ["string", "null"] }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "platform", "arch", "cpuModel", "cpuCount", "ci"],
      "properties": {
        "nodeVersion": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" },
        "cpuModel": { "type": "string" },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "ci": { "type": "boolean" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultWarmupIterations",
        "defaultMeasurementIterations",
        "advisoryMemory",
        "gcAvailable"
      ],
      "properties": {
        "defaultWarmupIterations": { "type": "integer", "minimum": 1 },
        "defaultMeasurementIterations": { "type": "integer", "minimum": 1 },
        "advisoryMemory": { "const": true },
        "gcAvailable": { "type": "boolean" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "name",
          "description",
          "warmupIterations",
          "measurementIterations",
          "samplesMs",
          "metrics",
          "memory"
        ],
        "properties": {
          "id": { "type": "string" },
          "group": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "warmupIterations": { "type": "integer", "minimum": 0 },
          "measurementIterations": { "type": "integer", "minimum": 1 },
          "samplesMs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number" }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minMs",
              "maxMs",
              "meanMs",
              "medianMs",
              "p95Ms",
              "stdDevMs",
              "opsPerSecond"
            ],
            "properties": {
              "minMs": { "type": "number" },
              "maxMs": { "type": "number" },
              "meanMs": { "type": "number" },
              "medianMs": { "type": "number" },
              "p95Ms": { "type": "number" },
              "stdDevMs": { "type": "number" },
              "opsPerSecond": { "type": "number" }
            }
          },
          "memory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gcAvailable",
              "rssBeforeBytes",
              "rssAfterBytes",
              "rssDeltaBytes",
              "heapUsedBeforeBytes",
              "heapUsedAfterBytes",
              "heapUsedDeltaBytes"
            ],
            "properties": {
              "gcAvailable": { "type": "boolean" },
              "rssBeforeBytes": { "type": "integer" },
              "rssAfterBytes": { "type": "integer" },
              "rssDeltaBytes": { "type": "integer" },
              "heapUsedBeforeBytes": { "type": "integer" },
              "heapUsedAfterBytes": { "type": "integer" },
              "heapUsedDeltaBytes": { "type": "integer" }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseCount", "totalMeasuredIterations"],
      "properties": {
        "caseCount": { "type": "integer", "minimum": 1 },
        "totalMeasuredIterations": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
