{
  "name": "templjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Project monorepo - Description goes here",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/project.git"
  },
  "license": "Apache-2.0",
  "author": "Chris Caldwell",
  "workspaces": [
    "src/packages/*",
    "src/extensions/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "build:affected": "pnpm run build:affected:local",
    "build:affected:ci": "nx affected -t build --base=origin/main --parallel=${NX_PARALLEL:-3} --outputStyle=static",
    "build:affected:local": "nx affected -t build --base=main --parallel=${NX_PARALLEL:-3}",
    "ci:build": "pnpm run build:affected:ci",
    "ci:frontmatter": "pnpm run lint:frontmatter",
    "ci:lint": "pnpm run lint:ci",
    "ci:test": "pnpm run test:affected:ci",
    "ci:type-check": "pnpm run type-check",
    "clean": "nx reset && rm -rf node_modules packages/*/node_modules extensions/*/node_modules packages/*/dist extensions/*/dist",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "graph": "nx graph",
    "hooks:commit-msg": "commitlint --edit",
    "hooks:pre-commit": "tsx scripts/ci/hook-runner.ts pre-commit",
    "hooks:pre-commit:verbose": "pnpm run hooks:pre-commit -- --verbose",
    "hooks:pre-push": "tsx scripts/ci/hook-runner.ts pre-push",
    "hooks:pre-push:verbose": "pnpm run hooks:pre-push -- --verbose",
    "lint": "pnpm run lint:local",
    "lint:ci": "pnpm run lint:eslint:affected --outputStyle=static && pnpm run lint:markdown && pnpm run format:check",
    "lint:eslint": "nx run-many -t lint",
    "lint:eslint:affected": "nx affected -t lint --base=origin/main --parallel=${NX_PARALLEL:-3}",
    "lint:eslint:fix": "pnpm run lint:eslint -- --fix",
    "lint:eslint:pre-push": "sh -c 'BASE_BRANCH=main; if git rev-parse --verify origin/main >/dev/null 2>&1; then BASE_BRANCH=origin/main; fi; pnpm exec nx affected -t lint --base=\"$BASE_BRANCH\" --parallel=${NX_PARALLEL:-3} --outputStyle=static'",
    "lint:eslint:staged:fix": "eslint --fix",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:markdown:fix && pnpm run format",
    "lint:frontmatter": "tsx scripts/ci/lint-frontmatter.ts",
    "lint:local": "pnpm run lint:eslint && pnpm run lint:markdown && pnpm run format:check && pnpm run lint:frontmatter",
    "lint:markdown": "sh scripts/ci/lint-markdown.sh",
    "lint:markdown:docs": "sh scripts/ci/lint-markdown.sh",
    "lint:markdown:fix": "sh scripts/ci/lint-markdown.sh --fix",
    "lint:root": "pnpm run lint:eslint",
    "lint:staged": "lint-staged",
    "preflight:strict": "pnpm run ci:frontmatter && pnpm run ci:lint && pnpm run ci:type-check && pnpm run ci:test && pnpm run ci:build",
    "prepare": "husky",
    "test": "nx run-many -t test",
    "test:affected": "pnpm run test:affected:local",
    "test:affected:ci": "tsx scripts/ci/run-affected-tests-watchdog.ts ci",
    "test:affected:local": "tsx scripts/ci/run-affected-tests-watchdog.ts local",
    "test:affected:pre-push": "tsx scripts/ci/run-affected-tests-watchdog.ts pre-push",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "latest",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@eslint/js": "latest",
    "@nx/js": "latest",
    "@nx/vitest": "22.5.1",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "latest",
    "ajv-formats": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "markdownlint-shell": "latest",
    "nx": "latest",
    "prettier": "latest",
    "ts-node": "latest",
    "tsx": "^4.21.0",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^7.0.0",
    "vitest": "^4.0.18",
    "yaml": "latest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "pnpm run lint:eslint:staged:fix --"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "backlog/**/*.{md,markdown}": [
      "prettier --write",
      "pnpm run lint:frontmatter --"
    ],
    "*.{md,markdown}": [
      "prettier --write",
      "pnpm run lint:markdown:fix --"
    ]
  },
  "engines": {
    "node": "25.6.1",
    "pnpm": "8.15.0"
  },
  "packageManager": "pnpm@8.15.0"
}
