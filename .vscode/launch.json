  "version": "0.2.0",
  "configurations": [
    {
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src/extensions/vscode"
      ],
      "name": "Launch TemplJS Extension",
      "outFiles": [
        "${workspaceFolder}/src/extensions/vscode/dist/extension.js",
        "${workspaceFolder}/src/extensions/vscode/dist/server.js"
      ],
      "preLaunchTask": "Build TemplJS Extension (dist)",
      "request": "launch",
      "type": "extensionHost"
    }
  ]
}
